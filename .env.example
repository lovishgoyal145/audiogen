# AudioGen Primary Core API Service (Default: 17000, Host: 127.0.0.1)
HOST=127.0.0.1
APP_HOST=127.0.0.1
PORT=17000
APP_PORT=17000
ENVIRONMENT=development
APP_NAME=AudioGen

# AudioGen Secondary Service Port Allocation Block (17001 - 17009)
WORKER_PORT=17001
METRICS_PORT=17002
WEBHOOK_PORT=17003
WEBSOCKET_PORT=17004
DOCS_PORT=17005
RESERVED_SLOT_6=17006
RESERVED_SLOT_7=17007
RESERVED_SLOT_8=17008
RESERVED_SLOT_9=17009

# Kaggle GPU Bridge Credentials (Required for Audio Generation)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
KAGGLE_KERNEL_SLUG=avidok/vco-worker

# Tunnel Registry (Upstash Redis REST KV Store)
# Supported conventions:
# - Base endpoint: https://<id>.upstash.io
# - Explicit read key path: https://<id>.upstash.io/get/tunnel_url
# The orchestrator automatically reads /get/tunnel_url, the server publishes to /set/tunnel_url,
# and pre-flight probes /ping (or /get/tunnel_url) directly.
TUNNEL_REGISTRY_WEBHOOK_URL=https://your-upstash-db.upstash.io
TUNNEL_REGISTRY_AUTH_TOKEN=your_upstash_rest_token

# Server Authentication (Shared secret / bearer token between gateway and server)
SERVER_BEARER_TOKEN=your_server_bearer_token

